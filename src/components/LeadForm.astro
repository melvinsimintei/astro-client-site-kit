---
// Generic Web3Forms lead-capture form. The MECHANICS here (POST target,
// honeypot, conditional redirect, progressive-enhancement reveal hooks) are
// genuinely universal infrastructure and don't need to change per client.
//
// The <style> block below is NOT brand-neutral just because it's token-driven —
// it's a working starting point for input/focus/spacing treatment, still one
// brand's visual opinion. Restyle it to match the new client's own design
// language; swapping colors alone will still read as a reskin. See the
// header comment in src/styles/global.css for the fuller version of this point.
//
// access_key is read from an env var, never hardcoded — see .env.example.
// A prior version of this file (the project this starter was extracted from)
// had a live Web3Forms key committed directly in source; don't repeat that.
import { site } from '../config/site.js';

export interface Field {
  id: string;
  name: string;
  label: string;
  type: 'text' | 'tel' | 'email' | 'url';
  placeholder?: string;
  autocomplete?: string;
  required?: boolean;
  optional?: boolean;
  pattern?: string;
  title?: string;
}

export interface Props {
  id?: string;
  heading: string;
  subheading?: string;
  fields: Field[];
  submitLabel: string;
  reassurance?: string;
  formSubject: string;
  redirectPath?: string;
}

const {
  id = 'lead-form',
  heading,
  subheading,
  fields,
  submitLabel,
  reassurance,
  formSubject,
  redirectPath = '/thank-you/',
} = Astro.props;

const redirectUrl = Astro.site ? new URL(redirectPath, Astro.site).toString() : null;

// The Kenya 10-digit phone format is a real target-market default, not a
// universal one — see src/config/site.js's `market` field. A field only gets
// this pattern automatically if it's type="tel" AND the client is in that
// market, and only if the caller didn't already specify their own pattern.
function effectivePattern(field: Field) {
  if (field.pattern) return field.pattern;
  if (field.type === 'tel' && site.market === 'KE') return '[0-9]{10}';
  return undefined;
}
function effectiveTitle(field: Field) {
  if (field.title) return field.title;
  if (field.type === 'tel' && site.market === 'KE') return 'Enter a 10-digit phone number, e.g. 0712345678';
  return undefined;
}
---

<div class="lead-form-wrap card" id={id} data-reveal>
  <h2 class="lead-form__heading" data-reveal>{heading}</h2>
  {subheading && <p class="lead-form__subheading" data-reveal data-reveal-delay="60">{subheading}</p>}

  <form class="lead-form" method="POST" action="https://api.web3forms.com/submit">
    <input type="hidden" name="access_key" value={import.meta.env.WEB3FORMS_ACCESS_KEY} />
    <input type="hidden" name="subject" value={formSubject} />
    {redirectUrl && <input type="hidden" name="redirect" value={redirectUrl} />}
    <input type="checkbox" name="botcheck" style="display:none;" tabindex="-1" autocomplete="off" />

    {fields.map((field, i) => (
      <div class="lead-form__field" data-reveal data-reveal-delay={120 + i * 60}>
        <label class="lead-form__label" for={field.id}>
          {field.label}{' '}
          {field.required && <span class="lead-form__required" aria-hidden="true">*</span>}
          {field.optional && <span class="lead-form__optional">(optional)</span>}
        </label>
        <input
          class="lead-form__input"
          type={field.type}
          inputmode={field.type === 'tel' ? 'tel' : undefined}
          id={field.id}
          name={field.name}
          placeholder={field.placeholder}
          autocomplete={field.autocomplete}
          pattern={effectivePattern(field)}
          title={effectiveTitle(field)}
          required={field.required}
        />
      </div>
    ))}

    <button class="btn btn-primary lead-form__submit" type="submit" data-reveal data-reveal-delay={120 + fields.length * 60}>
      {submitLabel}
    </button>

    {reassurance && (
      <p class="lead-form__reassurance" data-reveal data-reveal-delay={180 + fields.length * 60}>
        {reassurance}
      </p>
    )}
  </form>
</div>

<style>
  .lead-form-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  @media (min-width: 900px) {
    .lead-form-wrap {
      max-width: 560px;
      margin-inline: auto;
    }
  }

  .lead-form__heading {
    font-size: var(--text-xl);
    color: var(--text-primary);
  }

  .lead-form__subheading {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
  }

  .lead-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .lead-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .lead-form__label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    transition: color var(--motion-standard);
  }

  .lead-form__field:focus-within .lead-form__label {
    color: var(--brand-slate);
  }

  .lead-form__required {
    color: var(--brand-slate);
  }

  .lead-form__optional {
    font-weight: 400;
    color: var(--text-secondary);
    font-size: var(--text-xs);
  }

  .lead-form__input {
    width: 100%;
    min-height: 44px;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--text-primary);
    background: var(--surface-card);
    border: var(--border-width-emphasis) solid var(--border-hairline);
    border-radius: var(--radius-md);
    appearance: none;
    -webkit-appearance: none;
    transition: border-color var(--motion-standard);
  }

  .lead-form__input::placeholder {
    color: var(--text-secondary);
  }

  .lead-form__input:focus {
    outline: none;
    border-color: var(--brand-slate);
    /* Fallback-then-enhance pattern: browsers without color-mix() keep the
       first declaration, browsers with it get the second. Both derive from
       --brand-slate via the token, not a hand-copied hex — safe regardless of
       what the client's brand color ends up being. This dual-declaration-at-
       the-consuming-property technique is the one to reuse for any future
       token-derived inline style; see the color-mix() rationale in
       src/styles/global.css's header comment for why this differs from doing
       the same thing at a :root token definition. */
    box-shadow: 0 0 0 3px var(--border-emphasis);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-slate) 15%, transparent);
  }

  .lead-form__submit {
    margin-top: var(--space-2);
    width: 100%;
  }

  .lead-form__reassurance {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    text-align: center;
    line-height: 1.5;
  }
</style>
