---
// Bare shell so the kit builds. Write the real layout from scratch per client.
import { site } from '../config/site.js';
const { title = site.name, noindex = !site.publicLaunch } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
  </head>
  <body>
    <main><slot /></main>
  </body>
</html>
