# Copy to .env (gitignored) and fill in real values per client. Never commit
# real values — this file exists so the shape of what's needed is documented,
# not so it can be filled in and checked in.

# Web3Forms access key for this client's account. Read at build time by
# src/components/LeadForm.astro via import.meta.env.WEB3FORMS_ACCESS_KEY —
# never hardcode this as a literal value in a component file.
WEB3FORMS_ACCESS_KEY=

# The client's real site URL once one exists, e.g. https://example.com/
# (with trailing slash). Read by astro.config.mjs to set `site` — leave this
# blank until a real domain exists; a guessed domain is worse than none, see
# astro.config.mjs and src/layouts/Layout.astro for why.
PUBLIC_SITE_URL=
