# Copy to .env (gitignored) and fill in real values per client. Never commit
# real values — this file exists so the shape of what's needed is documented,
# not so it can be filled in and checked in.

# Web3Forms access key for this client's account. Read at build time via
# import.meta.env.WEB3FORMS_ACCESS_KEY: never hardcode it in a component.
WEB3FORMS_ACCESS_KEY=

# The client's real site URL once one exists, e.g. https://example.com/
# (with trailing slash). Read by astro.config.mjs (via Vite's loadEnv) to set
# `site` and turn on the sitemap — leave this blank until a real domain exists;
# a guessed domain is worse than none.
PUBLIC_SITE_URL=

# 'true' lets search engines index the site (read by src/config/site.js via
# import.meta.env). A real env var on Netlify works the same way.
PUBLIC_LAUNCH=false
