---
// REFERENCE ONLY — not imported anywhere in src/, not part of the build.
//
// A closing CTA band is genuinely common marketing-page furniture, but its
// default line/href/label were hardcoded in the file this was extracted
// from — a fixed default is exactly the "quietly presented as if universal"
// pattern this starter is trying to avoid. Here everything is a required
// prop instead; no baked-in copy or destination.
export interface Props {
  line: string;
  ctaHref: string;
  ctaLabel: string;
  inverse?: boolean;
}

const { line, ctaHref, ctaLabel, inverse = false } = Astro.props;
---

<section class:list={['section close-cta', { 'section--inverse': inverse }]}>
  <div class="container close-cta__inner" data-reveal>
    <p class="close-cta__line">{line}</p>
    <a href={ctaHref} class:list={['btn btn-primary', { 'btn-primary--on-inverse': inverse }]}>
      {ctaLabel}
    </a>
  </div>
</section>

<style>
  .close-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    text-align: center;
  }

  .close-cta__line {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    max-width: 30ch;
    line-height: 1.3;
  }

  .section--inverse .close-cta__line {
    color: var(--text-on-inverse);
  }
</style>
