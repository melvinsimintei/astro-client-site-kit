---
// REFERENCE ONLY — not imported anywhere in src/, not part of the build.
//
// Every client's nav item count, logo treatment, and CTA presence differs
// enough that a fully generic prop/slot-driven header would need so many
// props it becomes harder to read than a good copy-paste starting point.
// Build the real header fresh per client, but reuse these three techniques
// (all brand-agnostic, all worth keeping):
//   1. Mobile wordmark swap via pure CSS display toggling — no JS, no layout
//      shift, a small mark + two-line wordmark below ~900px, a full lockup
//      image above it.
//   2. mask-image horizontal-scroll-nav affordance — signals a nav row
//      scrolls sideways on narrow screens without a painted gradient.
//   3. @media (pointer: coarse) touch-target enlargement — taller hit areas
//      for touch input specifically, not a blanket padding increase at every
//      viewport width.
//
// No logo import here — point Image at the new client's own lockup/mark SVGs.
export interface NavLink {
  href: string;
  label: string;
}

export interface Props {
  navLinks: NavLink[];
  ctaHref: string;
  ctaLabel: string;
  brandLabel: string;
}

const { navLinks, ctaHref, ctaLabel, brandLabel } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__row">
    <a href="/" class="site-header__brand" aria-label={`${brandLabel}, home`}>
      <!-- Desktop: full lockup image. <Image class="site-header__logo--desktop" src={lockup} alt={brandLabel} loading="eager" /> -->
      <span class="site-header__logo--mobile">
        <!-- Mobile: small mark + two-line wordmark, not the full lockup. <Image class="site-header__mark-mobile" src={mark} alt="" loading="eager" width="28" height="28" /> -->
        <span class="site-header__wordmark-mobile">
          <span class="site-header__wordmark-mobile-top">{brandLabel}</span>
        </span>
      </span>
    </a>

    <a href={ctaHref} class="btn btn-primary site-header__cta">{ctaLabel}</a>
  </div>

  <nav class="container site-header__nav" aria-label="Primary">
    <ul class="site-header__links">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="site-header__link"
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--surface-card);
    border-bottom: var(--border-width-hairline) solid var(--border-hairline);
  }

  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-3);
    padding-bottom: var(--space-2);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
  }

  .site-header__logo--desktop {
    display: none;
  }

  .site-header__logo--mobile {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .site-header__wordmark-mobile {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    min-width: 0;
  }

  .site-header__wordmark-mobile-top {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--text-primary);
  }

  /* Technique 2: horizontal-scroll-nav affordance, not a painted gradient */
  .site-header__nav {
    padding-bottom: var(--space-3);
    overflow-x: auto;
    mask-image: linear-gradient(to right, black calc(100% - 32px), transparent);
    -webkit-mask-image: linear-gradient(to right, black calc(100% - 32px), transparent);
  }

  .site-header__links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
    white-space: nowrap;
  }

  .site-header__link {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-secondary);
    padding-block: var(--space-1);
    border-bottom: 2px solid transparent;
    transition: color var(--motion-standard), border-color var(--motion-standard);
  }

  .site-header__link:hover,
  .site-header__link:focus-visible {
    color: var(--brand-slate);
  }

  .site-header__link:focus-visible {
    outline: 2px solid var(--brand-slate);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .site-header__link[aria-current='page'] {
    color: var(--brand-slate);
    border-bottom-color: var(--brand-slate);
  }

  /* Technique 3: coarse pointers (touch) get a taller hit area than mouse/trackpad */
  @media (pointer: coarse) {
    .site-header__link {
      padding-block: var(--space-4);
    }
  }

  .site-header__cta {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    flex-shrink: 0;
    white-space: nowrap;
  }

  /* Technique 1: mobile wordmark swap via pure CSS display toggling */
  @media (min-width: 900px) {
    .site-header__row {
      padding-block: var(--space-4);
    }

    .site-header__logo--desktop {
      display: block;
      height: 32px;
      width: auto;
    }

    .site-header__logo--mobile {
      display: none;
    }

    .site-header__nav {
      mask-image: none;
      -webkit-mask-image: none;
    }

    .site-header__link {
      font-size: var(--text-sm);
    }

    .site-header__cta {
      padding: var(--space-3) var(--space-6);
      font-size: var(--text-base);
    }
  }
</style>
