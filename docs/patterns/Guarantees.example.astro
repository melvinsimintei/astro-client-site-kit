---
// REFERENCE ONLY — not imported anywhere in src/, not part of the build.
//
// A "trust/guarantee list" shape for whatever confidence statements the new
// client actually has — real ones, not invented. This is prop-driven (heading
// + items), which lowers the redesign burden compared to the other patterns
// in this folder, but the two-column ledger-divider layout below is still
// this brand's specific visual treatment. Reconsider it against the new
// client's Design Philosophy answer before reusing as-is.
export interface Item {
  name: string;
  body: string;
}

export interface Props {
  heading: string;
  items: Item[];
}

const { heading, items } = Astro.props;
---

<section class="section section--alt guarantees">
  <div class="container guarantees__inner">
    <div class="guarantees__row">
      <h2 class="guarantees__heading" data-reveal>{heading}</h2>

      <ul class="guarantees__list">
        {items.map((item, i) => (
          <li class="guarantees__item" data-reveal data-reveal-delay={String(i * 70)}>
            <svg class="guarantees__check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            <div class="guarantees__copy">
              <h3 class="guarantees__name">{item.name}</h3>
              <p class="guarantees__body">{item.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .guarantees__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .guarantees__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .guarantees__heading {
    font-size: var(--text-2xl);
    max-width: 40ch;
  }

  .guarantees__list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .guarantees__item {
    display: flex;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: var(--border-width-hairline) solid var(--border-emphasis);
  }

  .guarantees__item:last-child {
    border-bottom: var(--border-width-hairline) solid var(--border-emphasis);
  }

  .guarantees__check {
    flex-shrink: 0;
    color: var(--brand-slate);
    margin-top: 0.15rem;
  }

  .guarantees__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .guarantees__name {
    font-size: var(--text-md);
  }

  .guarantees__body {
    color: var(--text-secondary);
    line-height: 1.55;
    font-size: var(--text-sm);
    max-width: 55ch;
  }

  @media (min-width: 700px) {
    .guarantees__item {
      align-items: baseline;
    }

    .guarantees__copy {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: var(--space-8);
      flex: 1;
    }
  }

  @media (min-width: 900px) {
    .guarantees__row {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-12);
    }

    .guarantees__heading {
      flex: 0.6;
    }

    .guarantees__list {
      flex: 1.4;
    }
  }
</style>
